{
  "name": "media-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "sync:movie-folders": "node --experimental-strip-types scripts/sync-movie-folders.mjs",
    "local:movies": "node --experimental-strip-types scripts/local-movie-service.mjs",
    "test:movie-files": "node --experimental-strip-types --test tests/movie-files.test.mjs tests/movie-folder-sync.test.mjs tests/movie-service-http.test.mjs tests/movie-playback-token.test.mjs",
    "test:genres": "node --experimental-strip-types --test tests/genres.test.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "typescript": "^5",
    "prisma": "^6.4.1"
  }
}